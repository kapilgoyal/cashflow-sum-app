# Copy to .env locally (never commit real values).

# Prototype default when unset: sqlite file
#   sqlite:////data/cashflow.db     (container; /data is ephemeral without a volume)
#   sqlite:///./data/cashflow.db    (local, relative to process cwd)
#   sqlite:////absolute/path/cashflow.db
#
# Postgres/Neon: any postgres:// or postgresql:// URL keeps the existing path.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Combined Azure image: leave VITE_API_BASE_URL unset (same-origin /api).
# Optional only when UI and API are on different origins (no trailing slash).
# VITE_API_BASE_URL=

# Groq Loan QC English→rule. REQUIRED — no mock fallback if missing/failed.
# GROQ_API_KEY=
# Optional model override (default openai/gpt-oss-20b; llama-3.1-8b-instant often 404s).
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL_FALLBACKS=llama-3.1-8b-instant,llama-3.3-70b-versatile,qwen/qwen3-32b
