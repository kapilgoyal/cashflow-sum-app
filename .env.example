# Copy to .env locally (never commit real values).

# Neon Postgres (Railway, Azure Container App, local API)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Combined Azure image: leave VITE_API_BASE_URL unset (same-origin /api).
# Vercel-only UI still needs this at build time, no trailing slash.
# VITE_API_BASE_URL=https://your-service.up.railway.app
